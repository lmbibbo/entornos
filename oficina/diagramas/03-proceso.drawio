        <mxCell id="ref" value="&lt;table style='border-collapse:collapse;width:100%;font-family:Arial;font-size:9px;color:#1F1F1F;'&gt;
&lt;thead&gt;
&lt;tr&gt;
&lt;th style='background:#E8EAED;border:1px solid #9AA0A6;padding:5px 6px;text-align:left;'&gt;PR&lt;/th&gt;
&lt;th style='background:#E8EAED;border:1px solid #9AA0A6;padding:5px 6px;text-align:left;'&gt;Etiqueta del arco&lt;/th&gt;
&lt;th style='background:#E8EAED;border:1px solid #9AA0A6;padding:5px 6px;text-align:left;'&gt;Tramo&lt;/th&gt;
&lt;th style='background:#E8EAED;border:1px solid #9AA0A6;padding:5px 6px;text-align:left;'&gt;Rol&lt;/th&gt;
&lt;th style='background:#E8EAED;border:1px solid #9AA0A6;padding:5px 6px;text-align:left;'&gt;Objeto&lt;/th&gt;
&lt;th style='background:#E8EAED;border:1px solid #9AA0A6;padding:5px 6px;text-align:left;'&gt;Operación&lt;/th&gt;
&lt;/tr&gt;
&lt;/thead&gt;
&lt;tbody&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-01&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;abrir&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;Inicio → BriefingCreativo&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;EjecutivoDeCuenta&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;BriefingCampana&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;traducir el pedido &lt;span style='color:#8C8C8C'&gt;(OP-EJE-01)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-02&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;curar&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;BriefingCreativo → CuraduriaReferencias&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;CreativoSenior&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;TableroMoodboard&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;cargar referencias &lt;span style='color:#8C8C8C'&gt;(OP-CRE-04)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-03&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;handoff TR-01&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;CuraduriaReferencias → CoCreacionPieza&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;DirectorDeArte&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;TableroMoodboard&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;elegir el territorio &lt;span style='color:#8C8C8C'&gt;(OP-DIR-04)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-04&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;exportar&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;CoCreacionPieza → IteracionVersion&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;MotionDesigner&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;PaqueteExportacion&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;exportar el paquete &lt;span style='color:#8C8C8C'&gt;(OP-MOT-03)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-05&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;handoff TR-02&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;IteracionVersion → CriticaColectiva&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;DirectorDeArte&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;PiezaGrafica&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;dar el visto bueno &lt;span style='color:#8C8C8C'&gt;(OP-DIR-11)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-06&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;veredicto&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;CriticaColectiva → D1&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;DirectorDeArte&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;RegistroCritica&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;emitir el veredicto &lt;span style='color:#8C8C8C'&gt;(OP-DIR-15)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-07&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;vuelve&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;D1 → IteracionVersion&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;DirectorDeArte&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;PiezaGrafica&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;reabrir un ítem &lt;span style='color:#8C8C8C'&gt;(OP-DIR-12)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-08&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;pasa&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;D1 → ChecklistEntrega&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;RevisorDeCalidad&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;ChecklistCalidad&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;aplicar el checklist &lt;span style='color:#8C8C8C'&gt;(OP-REV-04)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-09&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;firmar&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;ChecklistEntrega → D2&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;DirectorDeArte&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;ChecklistCalidad&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;firmar el pase &lt;span style='color:#8C8C8C'&gt;(OP-DIR-17)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-10&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;corrige&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;D2 → IteracionVersion&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;DisenadorGrafico&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;PiezaEnRevision&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;corregir los ítems marcados &lt;span style='color:#8C8C8C'&gt;(OP-DIS-09)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-11&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;aprueba&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;D2 → PresentacionPropuesta&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;EjecutivoDeCuenta&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;PropuestaComercial&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;conducir la presentación &lt;span style='color:#8C8C8C'&gt;(OP-EJE-07)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-12&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;feedback&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;PresentacionPropuesta → RondaFeedback&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;EjecutivoDeCuenta&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;HiloFeedback&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;ordenar el feedback &lt;span style='color:#8C8C8C'&gt;(OP-EJE-10)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-13&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;cierra&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;RondaFeedback → D3&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;EjecutivoDeCuenta&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;HiloFeedback&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;confirmar el cierre &lt;span style='color:#8C8C8C'&gt;(OP-EJE-12)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-14&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;cambios&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;D3 → IteracionVersion&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;EjecutivoDeCuenta&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;HiloFeedback&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;derivar correcciones &lt;span style='color:#8C8C8C'&gt;(OP-EJE-11)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;tr&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;&lt;b style='color:#2F5D8A'&gt;PR-15&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;handoff TR-05&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;D3 → Fin&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;Cliente&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;ActaAprobacion&lt;/td&gt;&lt;td style='border:1px solid #C6C6C6;padding:4px 6px;'&gt;marcar aprobaciones &lt;span style='color:#8C8C8C'&gt;(OP-CLI-06)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="52" y="104" width="1496" height="352" as="geometry" />
        </mxCell>
        <mxCell id="refnote" value="&lt;b&gt;Rol → Objeto — Operación:&lt;/b&gt; el rol ejecuta la operación sobre el artefacto a través de la herramienta declarada en proceso.md §3. La &lt;i&gt;etiqueta del arco&lt;/i&gt; es el texto que aparece sobre la flecha PR en la página «Proceso colaborativo»; D1–D3 son las compuertas de decisión." style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=8.5;fontColor=#5A5A5A;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="52" y="470" width="1496" height="32" as="geometry" />
        </mxCell>
        <mxCell id="footer2" value="Fuente: proceso.md §3 · 15 transiciones PR · tabla derivada de la fuente única; no se edita aquí" style="text;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontFamily=Arial;fontSize=7.5;fontColor=#8C8C8C;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="48" y="840" width="940" height="16" as="geometry" />
        </mxCell>
